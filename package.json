{
  "name": "glass-controls",
  "version": "0.2.0",
  "description": "A framework-free control layer of liquid glass: one WebGL2 engine for surfaces and lenses, frosted menus, sliders, segmented controls, switches and spring touch physics.",
  "type": "module",
  "main": "dist/glass-controls.js",
  "module": "dist/glass-controls.js",
  "types": "dist/glass-controls.d.ts",
  "exports": {
    ".": {
      "types": "./dist/glass-controls.d.ts",
      "import": "./dist/glass-controls.js",
      "default": "./dist/glass-controls.js"
    },
    "./glass-controls.css": "./dist/glass-controls.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=esm --outfile=dist/glass-controls.js && esbuild src/index.js --bundle --minify --format=esm --outfile=dist/glass-controls.min.js && cp src/glass-controls.css src/glass-controls.d.ts dist/",
    "check": "npm run build && node scripts/check.mjs",
    "serve": "python3 -m http.server 8811"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "keywords": [
    "glass",
    "liquid-glass",
    "refraction",
    "webgl2",
    "backdrop-filter",
    "spring",
    "ui-controls",
    "slider",
    "segmented-control",
    "switch"
  ],
  "license": "MIT",
  "author": "Thomas Kramer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takramer/glass-controls.git"
  },
  "homepage": "https://github.com/Takramer/glass-controls#readme",
  "bugs": {
    "url": "https://github.com/Takramer/glass-controls/issues"
  }
}
